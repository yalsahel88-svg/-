<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>الحل النهائي | جزئي المفقود</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --background: #070707;
      --card: #141414;
      --card-light: #191919;
      --border: #2b2b2b;
      --text: #f5f5f5;
      --muted: #b9b9b9;
      --red: #ff4d55;
      --dark-red: #9e1f25;
      --green: #22c76a;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background:
        radial-gradient(circle at top, rgba(120, 0, 0, 0.12), transparent 32%),
        var(--background);
      color: var(--text);
      font-family: "Cairo", sans-serif;
      line-height: 1.9;
      overflow-x: hidden;
    }

    button {
      font-family: inherit;
    }

    .hidden {
      display: none;
    }

    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .warning {
      width: 100%;
      max-width: 650px;
      padding: 38px 26px;
      text-align: center;
      background: rgba(20, 10, 10, 0.96);
      border: 1px solid var(--dark-red);
      border-radius: 24px;
      box-shadow: 0 25px 80px rgba(0, 0, 0, 0.65);
    }

    .warning-symbol {
      width: 58px;
      height: 58px;
      margin: 0 auto 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--dark-red);
      border-radius: 50%;
      color: var(--red);
      font-size: 28px;
      font-weight: 900;
    }

    .warning h1 {
      color: var(--red);
      font-size: clamp(34px, 9vw, 52px);
      margin-bottom: 15px;
    }

    .warning p {
      color: #dddddd;
      font-size: 17px;
    }

    .warning button {
      margin-top: 30px;
      padding: 16px 38px;
      border: 0;
      border-radius: 13px;
      background: var(--dark-red);
      color: white;
      font-size: 18px;
      font-weight: 900;
      cursor: pointer;
      transition: 0.25s;
    }

    .warning button:active {
      transform: scale(0.96);
    }

    .page {
      animation: pageEnter 0.8s ease;
    }

    @keyframes pageEnter {
      from {
        opacity: 0;
      }

      to {
        opacity: 1;
      }
    }

    .container {
      width: min(900px, calc(100% - 34px));
      margin: auto;
    }

    section {
      padding: 64px 0;
    }

    .section-title {
      margin-bottom: 30px;
      text-align: center;
      font-size: clamp(36px, 10vw, 60px);
      font-weight: 900;
      line-height: 1.35;
    }

    .section-subtitle {
      max-width: 650px;
      margin: -12px auto 30px;
      text-align: center;
      color: var(--muted);
      font-size: 16px;
    }

    .card {
      padding: 28px 24px;
      margin-bottom: 22px;
      background: linear-gradient(145deg, var(--card-light), #101010);
      border: 1px solid var(--border);
      border-radius: 22px;
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.35);
    }

    .card h2 {
      margin-bottom: 12px;
      font-size: clamp(24px, 6vw, 34px);
      line-height: 1.5;
    }

    .card p {
      color: #dddddd;
      font-size: 17px;
    }

    .truth-card {
      padding: 42px 25px;
      text-align: center;
      background: linear-gradient(160deg, #280e0f, #120909);
      border: 1px solid var(--dark-red);
    }

    .truth-label {
      display: inline-block;
      margin-bottom: 16px;
      padding: 6px 17px;
      color: var(--red);
      background: rgba(255, 77, 85, 0.08);
      border: 1px solid rgba(255, 77, 85, 0.35);
      border-radius: 999px;
      font-size: 14px;
      font-weight: 700;
    }

    .truth-card h1 {
      color: var(--red);
      font-size: clamp(38px, 11vw, 66px);
      line-height: 1.35;
      margin-bottom: 15px;
    }

    .truth-card strong {
      display: block;
      margin-top: 20px;
      font-size: clamp(25px, 7vw, 40px);
      line-height: 1.7;
    }

    .suspects {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 15px;
    }

    .suspect {
      padding: 22px 16px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 17px;
      text-align: center;
    }

    .suspect h3 {
      font-size: 19px;
      margin-bottom: 7px;
    }

    .suspect span {
      color: var(--muted);
      font-size: 13px;
    }

    .round-title {
      margin: 16px 0 25px;
      text-align: center;
      color: var(--muted);
      font-size: 16px;
      font-weight: 600;
    }

    .eliminated {
      border-right: 6px solid var(--green);
    }

    .final-suspect {
      border-right: 6px solid var(--red);
    }

    .status {
      margin-left: 8px;
      font-size: 25px;
      vertical-align: middle;
    }

    .evidence {
      list-style: none;
      margin-top: 12px;
    }

    .evidence li {
      position: relative;
      padding-right: 24px;
      margin-top: 9px;
      color: #d8d8d8;
      font-size: 16px;
    }

    .evidence li::before {
      content: "•";
      position: absolute;
      right: 5px;
      color: var(--green);
      font-size: 23px;
      line-height: 1.4;
    }

    .final-suspect .evidence li::before {
      color: var(--red);
    }

    .timeline {
      position: relative;
      padding-right: 28px;
    }

    .timeline::before {
      content: "";
      position: absolute;
      right: 7px;
      top: 8px;
      bottom: 8px;
      width: 2px;
      background: #3b3b3b;
    }

    .timeline-item {
      position: relative;
      margin-bottom: 24px;
    }

    .timeline-item::before {
      content: "";
      position: absolute;
      right: -27px;
      top: 10px;
      width: 12px;
      height: 12px;
      background: var(--red);
      border: 3px solid var(--background);
      border-radius: 50%;
    }

    .timeline-time {
      color: var(--red);
      font-weight: 900;
      font-size: 16px;
    }

    .timeline-item p {
      margin-top: 4px;
      color: #d9d9d9;
      font-size: 16px;
    }

    .ending {
      padding-bottom: 90px;
    }

    .ending-card {
      text-align: center;
      border-color: var(--dark-red);
      background: linear-gradient(160deg, #240d0e, #100909);
    }

    .ending-card h2 {
      color: var(--red);
      font-size: clamp(36px, 9vw, 55px);
    }

    .ending-card .answer {
      display: block;
      margin: 22px 0;
      color: white;
      font-size: clamp(27px, 7vw, 41px);
      font-weight: 900;
      line-height: 1.7;
    }

    .closing-line {
      margin-top: 35px;
      text-align: center;
      color: #9a9a9a;
      font-size: 16px;
    }

    footer {
      padding: 20px 20px 60px;
      text-align: center;
      color: #777777;
      font-size: 14px;
    }

    .reveal {
      opacity: 0;
      transform: translateY(26px);
      transition: opacity 0.65s ease, transform 0.65s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    @media (min-width: 720px) {
      .suspects {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .card {
        padding: 34px;
      }
    }
  </style>
</head>

<body>

  <main class="hero" id="warningScreen">
    <div class="warning">
      <div class="warning-symbol">!</div>

      <h1>تنبيه</h1>

      <p>
        أنت على وشك الاطلاع على الحل النهائي لقضية
        <strong>جزئي المفقود</strong>.
        <br><br>
        إذا لم تنهِ التحقيق بعد، توقف هنا.
      </p>

      <button type="button" onclick="openSolution()">
        كشف الحقيقة
      </button>
    </div>
  </main>

  <div class="page hidden" id="solution">

    <section>
      <div class="container">
        <div class="card truth-card">
          <span class="truth-label">الحل النهائي</span>

          <h1>من قتل راشد؟</h1>

          <p>بعد مراجعة جميع الأدلة، اتضح أن القضية لم تكن جريمة قتل.</p>

          <strong>
            لم يكن هناك قاتل.<br>
            راشد عثمان أنهى حياته بنفسه.
          </strong>
        </div>
      </div>
    </section>

    <section>
      <div class="container">
        <h2 class="section-title reveal">بداية القضية</h2>

        <div class="card reveal">
          <p>
            راشد عثمان، 26 سنة، عُثر عليه مصابًا بطلقة في الرأس داخل غرفة نومه.
            بدأ الاشتباه بسعد بعدما دخل المخفر وملابسه ملطخة بالدم، وهو لا يتذكر
            تسلسل ما حدث بسبب اضطراب الذاكرة الذي يعاني منه.
          </p>
        </div>
      </div>
    </section>

    <section>
      <div class="container">
        <h2 class="section-title reveal">المشتبه فيهم</h2>

        <div class="suspects">
          <div class="suspect reveal">
            <h3>سعد علي</h3>
            <span>صديق الضحية</span>
          </div>

          <div class="suspect reveal">
            <h3>عبدالله محمد</h3>
            <span>خلافات سابقة</span>
          </div>

          <div class="suspect reveal">
            <h3>غالية فهد</h3>
            <span>طليقة راشد</span>
          </div>

          <div class="suspect reveal">
            <h3>وليد عثمان</h3>
            <span>شقيق الضحية</span>
          </div>

          <div class="suspect reveal">
            <h3>زكريا</h3>
            <span>حارس العمارة</span>
          </div>

          <div class="suspect reveal">
            <h3>د. أبرار</h3>
            <span>الطبيبة النفسية</span>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="container">
        <h2 class="section-title reveal">التقليص الأول</h2>
        <p class="round-title reveal">تم استبعاد مشتبهين من أصل ستة</p>

        <div class="card eliminated reveal">
          <h2>
            <span class="status">✅</span>
            استبعاد عبدالله محمد
          </h2>

          <ul class="evidence">
            <li>رمز 🍁 في تغريداته وتغريدات سارة كشف علاقتهما.</li>
            <li>صورة مكالمة الفيديو أثبتت وجوده بالواجهة البحرية وقت الواقعة.</li>
          </ul>
        </div>

        <div class="card eliminated reveal">
          <h2>
            <span class="status">✅</span>
            استبعاد د. أبرار
          </h2>

          <ul class="evidence">
            <li>هايلايت الجري 🏃🏻‍♀️ في حسابها على إنستغرام.</li>
            <li>الصورة أثبتت وجودها في حديقة الشهيد وقت وقوع الواقعة.</li>
          </ul>
        </div>
      </div>
    </section>

    <section>
      <div class="container">
        <h2 class="section-title reveal">التقليص الثاني</h2>
        <p class="round-title reveal">بقي أربعة مشتبهين</p>

        <div class="card eliminated reveal">
          <h2>
            <span class="status">✅</span>
            استبعاد غالية فهد
          </h2>

          <ul class="evidence">
            <li>ورقة المراجعة النفسية أثبتت خوفها الشديد من المطر.</li>
            <li>تغريدة عبدالله القديمة أكدت أن زوجته لا تستطيع الخروج أثناء المطر.</li>
          </ul>
        </div>

        <div class="card eliminated reveal">
          <h2>
            <span class="status">✅</span>
            استبعاد زكريا
          </h2>

          <ul class="evidence">
            <li>أقواله تطابقت مع تسجيلات الكاميرات.</li>
            <li>كان عند عمارة سعد، والمسافة لا تسمح له بالوصول وتنفيذ الواقعة قبل الطلقة.</li>
          </ul>
        </div>
      </div>
    </section>

    <section>
      <div class="container">
        <h2 class="section-title reveal">المشتبهان الأخيران</h2>

        <div class="card final-suspect reveal">
          <h2>وليد عثمان</h2>

          <ul class="evidence">
            <li>تقرير الحساسية يثبت معاناته من حساسية شديدة تجاه الكلاب.</li>
            <li>كلب راشد كان داخل الشقة، والباب لم يتعرض للكسر أو الاقتحام.</li>
          </ul>
        </div>

        <div class="card final-suspect reveal">
          <h2>سعد علي</h2>

          <ul class="evidence">
            <li>كاميرا مدخل عمارة راشد سجلت وصوله الساعة 03:28:05.</li>
            <li>صوت الطلقة كان قرابة الساعة 03:32.</li>
            <li>المدة لا تكفي للصعود إلى الدور الثالث والوصول إلى غرفة النوم وتنفيذ الواقعة.</li>
          </ul>
        </div>
      </div>
    </section>

    <section>
      <div class="container">
        <h2 class="section-title reveal">ما الذي حدث؟</h2>

        <div class="card reveal">
          <div class="timeline">

            <div class="timeline-item">
              <span class="timeline-time">قبل الواقعة</span>
              <p>
                وصل إلى سعد كلام مقلق من راشد، وفهم منه أن راشد قد يقدم على إيذاء نفسه.
              </p>
            </div>

            <div class="timeline-item">
              <span class="timeline-time">الاستعجال</span>
              <p>
                خرج سعد من عمارته بسرعة واتجه مباشرة إلى شقة راشد، ومن شدة ارتباكه
                نسي حبوب علاجه داخل شقته.
              </p>
            </div>

            <div class="timeline-item">
              <span class="timeline-time">03:28:05</span>
              <p>
                سجلت الكاميرا وصول سعد إلى مدخل عمارة راشد.
              </p>
            </div>

            <div class="timeline-item">
              <span class="timeline-time">قرابة 03:32</span>
              <p>
                وقعت الطلقة، وكان سعد قد وصل إلى المكان قبلها بدقائق قليلة فقط.
              </p>
            </div>

            <div class="timeline-item">
              <span class="timeline-time">بعد الواقعة</span>
              <p>
                وصل سعد إلى راشد وحاول الاقتراب منه ومساعدته، فانتقل الدم إلى يديه
                وملابسه. ومع غياب حبوب علاجه والصدمة التي تعرض لها، فقد أجزاءً من
                ذاكرته ولم يعد يعرف تسلسل ما حدث.
              </p>
            </div>

          </div>
        </div>
      </div>
    </section>

    <section class="ending">
      <div class="container">

        <div class="card ending-card reveal">
          <h2>الخلاصة</h2>

          <p>
            استُبعد جميع المشتبه فيهم بالأدلة الزمنية والطبية والرقمية.
          </p>

          <span class="answer">
            القضية لم تكن جريمة قتل.<br>
            راشد عثمان هو من أطلق النار على نفسه.
          </span>

          <p>
            وجود الدم على سعد لم يكن دليل إدانة، بل نتيجة وصوله إلى راشد
            ومحاولته مساعدته بعد الواقعة.
          </p>
        </div>

        <p class="closing-line reveal">
          أحيانًا لا يكون الجزء المفقود شخصًا... بل الحقيقة نفسها.
        </p>

      </div>
    </section>

    <footer>
      BLACK BOX © 2026
    </footer>

  </div>

  <script>
    function openSolution() {
      const warningScreen = document.getElementById("warningScreen");
      const solution = document.getElementById("solution");

      warningScreen.style.display = "none";
      solution.classList.remove("hidden");

      window.scrollTo({
        top: 0,
        behavior: "smooth"
      });

      setTimeout(revealVisibleElements, 100);
    }

    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
          }
        });
      },
      {
        threshold: 0.12
      }
    );

    document.querySelectorAll(".reveal").forEach(element => {
      observer.observe(element);
    });

    function revealVisibleElements() {
      document.querySelectorAll(".reveal").forEach(element => {
        const rect = element.getBoundingClientRect();

        if (rect.top < window.innerHeight - 40) {
          element.classList.add("visible");
        }
      });
    }
  </script>

</body>
</html>
